<Window x:Class="Assignment10_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment10_3"
        mc:Ignorable="d"
        Title="Car Inventory" Height="620" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Car Inventory" FontSize="22" FontWeight="SemiBold" Foreground="SteelBlue"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Yu Gothic UI Semibold" FontStyle="Italic"/>

        <DataGrid x:Name="CarGrid" Grid.Row="1" Margin="8" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" BorderBrush="SteelBlue" BorderThickness="2" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding CarId}"/>
                <DataGridTextColumn Header="VIN" Binding="{Binding VIN}" Width="170"/>
                <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="110"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="110"/>
                <DataGridTextColumn Header="Year" Binding="{Binding Year}"/>
                <DataGridTextColumn Header="Mileage" Binding="{Binding Mileage, StringFormat=N0}" Width="80"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="100"/>
                <DataGridTemplateColumn Header="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit" Click="EditCar" Padding="8,1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteCar" Padding="8,1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="SteelBlue" BorderThickness="2" Margin="8" Background="White">
            <StackPanel Margin="6">
                <Label x:Name="lblForm" Content="Add Car" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <Grid x:Name="CarFormGrid" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="VIN"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding VIN}" MaxLength="17" CharacterCasing="Upper"/>
                    <Label Grid.Row="1" Content="Make"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="2" Text="{Binding Make}"/>
                    <Label Grid.Row="2" Content="Model"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="2" Text="{Binding Model}"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="Year"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="2" Text="{Binding Year}"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="Mileage"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="2" Text="{Binding Mileage}"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="Price"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="2" Text="{Binding Price}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnSave" Content="Add" Width="90" Margin="4"
                            Background="SteelBlue" Foreground="White" BorderThickness="0" Click="btnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Cancel" Width="90" Margin="4" Visibility="Collapsed" Click="btnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
